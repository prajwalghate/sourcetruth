-- A choice whose body is trivial, followed by a large block comment. Once comments are stripped the
-- captured body is hundreds of characters of near-pure whitespace with no `<-` anywhere in it — the
-- shape that once made the resolver's binder regex non-terminating.
module Pathological where

template Session
  with
    host : Party
  where
    signatory host

    choice Cancel : ()
      with
        anyone : Party
      controller anyone
        do
          return ()

